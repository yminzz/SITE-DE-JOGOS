<!DOCTYPE html>

<html lang="pt-BR">

<head>

<meta charset="UTF-8">

<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>Comunidades | SCourge</title>


<style>

    * {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
    }


    body {
        background: #050505;
        color: #f5f5f5;
        font-family: Arial, Helvetica, sans-serif;
    }




    header {
        height: 80px;
        display: flex;
        align-items: center;
        padding: 0 55px;
        border-bottom: 1px solid #252525;
        background: #080808;
    }


    .logo-area {
        display: flex;
        align-items: center;
        gap: 14px;
    }


    .logo-area img {
        width: 52px;
        height: 52px;
        object-fit: cover;
        border-radius: 8px;
    }


    .logo-area h1 {
        font-size: 26px;
        letter-spacing: 1px;
    }


    

    nav {
        height: 58px;
        display: flex;
        align-items: center;
        padding: 0 55px;
        border-bottom: 1px solid #202020;
        background: #090909;
    }


    nav ul {
        list-style: none;
        display: flex;
        gap: 38px;
    }


    nav a {
        color: #aaa;
        text-decoration: none;
        font-size: 15px;
        transition: 0.2s;
    }


    nav a:hover {
        color: white;
    }


    nav .ativo {
        color: #ff2b2b;
        font-weight: bold;
    }


    /* 
       conmtyerudo
     */

    main {
        max-width: 1250px;
        margin: auto;
        padding: 45px 30px 80px;
    }


    .titulo {
        margin-bottom: 30px;
    }


    .titulo h2 {
        font-size: 38px;
        margin-bottom: 10px;
    }


    .titulo h2 span {
        color: #ff2b2b;
    }


    .titulo p {
        color: #999;
        font-size: 16px;
    }


    /* 
       pesquisa
     */

    .barra-pesquisa {
        display: flex;
        gap: 12px;
        margin-bottom: 45px;
    }


    .barra-pesquisa input {
        flex: 1;
        background: #111;
        border: 1px solid #292929;
        color: white;
        padding: 15px 18px;
        border-radius: 8px;
        font-size: 15px;
        outline: none;
    }


    .barra-pesquisa input:focus {
        border-color: #ff2b2b;
    }


    .botao-criar {
        background: #e52222;
        border: none;
        color: white;
        padding: 0 24px;
        border-radius: 8px;
        font-weight: bold;
        cursor: pointer;
        transition: 0.2s;
    }


    .botao-criar:hover {
        background: #ff3333;
        transform: translateY(-2px);
    }


    /* =========================
       seções
    ========================= */

    .titulo-secao {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 20px;
    }


    .titulo-secao h3 {
        font-size: 22px;
    }


    .titulo-secao span {
        color: #777;
        font-size: 13px;
    }


    

    .cards-destaque {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 20px;
        margin-bottom: 50px;
    }


    .card-destaque {
        min-height: 210px;
        padding: 25px;
        border-radius: 12px;
        background: linear-gradient(
            145deg,
            #171717,
            #0b0b0b
        );
        border: 1px solid #292929;
        position: relative;
        overflow: hidden;
        transition: 0.25s;
    }


    .card-destaque::before {
        content: "";
        position: absolute;
        width: 100%;
        height: 3px;
        background: #e52222;
        top: 0;
        left: 0;
    }


    .card-destaque:hover {
        transform: translateY(-5px);
        border-color: #e52222;
        box-shadow: 0 10px 35px rgba(255, 0, 0, 0.12);
    }


    .icone {
        width: 52px;
        height: 52px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: #1e1e1e;
        border-radius: 10px;
        font-size: 25px;
        margin-bottom: 18px;
    }


    .card-destaque h4 {
        font-size: 21px;
        margin-bottom: 8px;
    }


    .descricao {
        color: #999;
        font-size: 14px;
        line-height: 1.5;
        margin-bottom: 18px;
    }


    .card-inferior {
        display: flex;
        align-items: center;
        justify-content: space-between;
    }


    .membros {
        color: #777;
        font-size: 13px;
    }


    .botao-entrar {
        color: #ff3030;
        text-decoration: none;
        font-size: 13px;
        font-weight: bold;
    }


    .botao-entrar:hover {
        color: white;
    }


    

    .todas-comunidades {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 15px;
        margin-bottom: 55px;
    }


    .card-comunidade {
        background: #101010;
        border: 1px solid #252525;
        border-radius: 10px;
        padding: 20px;
        transition: 0.2s;
    }


    .card-comunidade:hover {
        border-color: #ff2b2b;
        background: #141414;
    }


    .card-comunidade .emoji {
        font-size: 27px;
        margin-bottom: 13px;
    }


    .card-comunidade h4 {
        margin-bottom: 7px;
    }


    .card-comunidade p {
        color: #777;
        font-size: 13px;
    }


    /* aqui as discusseosd */

    .discussoes {
        border: 1px solid #242424;
        border-radius: 10px;
        overflow: hidden;
        background: #0d0d0d;
    }


    .discussao {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 20px 24px;
        border-bottom: 1px solid #202020;
        transition: 0.2s;
    }


    .discussao:last-child {
        border-bottom: none;
    }


    .discussao:hover {
        background: #151515;
    }


    .discussao h4 {
        margin-bottom: 7px;
        font-size: 15px;
    }


    .discussao p {
        color: #777;
        font-size: 13px;
    }


    .comentarios {
        color: #888;
        font-size: 13px;
        white-space: nowrap;
    }


    /* 
       tempaltes aqui
     */

    @media (max-width: 900px) {

        .cards-destaque {
            grid-template-columns: 1fr;
        }

        .todas-comunidades {
            grid-template-columns: repeat(2, 1fr);
        }

        header,
        nav {
            padding-left: 25px;
            padding-right: 25px;
        }

    }


    @media (max-width: 600px) {

        nav ul {
            gap: 15px;
        }

        nav a {
            font-size: 12px;
        }

        main {
            padding: 30px 18px;
        }

        .titulo h2 {
            font-size: 30px;
        }

        .barra-pesquisa {
            flex-direction: column;
        }

        .botao-criar {
            height: 48px;
        }

        .todas-comunidades {
            grid-template-columns: 1fr;
        }

        .discussao {
            gap: 15px;
        }

    }

</style>


</head>

<body>



<header>

    <div class="logo-area">

        <a href="index.html">
            <img src="Logo_SCourge.jpeg" alt="Logo SCourge">
        </a>

        <h1>SCourge</h1>

    </div>

</header>


<!-- 
     auiq o menu
 -->

<nav>

    <ul>

        <li>
            <a href="index.html">Início</a>
        </li>

        <li>
            <a href="#">Novidades</a>
        </li>

        <li>
            <a href="#">Navegar</a>
        </li>

        <li>
            <a href="comunidades.html" class="ativo">
                Comunidades
            </a>
        </li>

        <li>
            <a href="#">Conta</a>
        </li>

    </ul>

</nav>


<!-- =========================
     cinteudo
========================= -->

<main>


    <div class="titulo">

        <h2>
            Encontre sua <span>comunidade.</span>
        </h2>

        <p>
            Converse, compartilhe e encontre jogadores que gostam dos mesmos jogos que você.
        </p>

    </div>


    <!-- BUSCA -->

    <div class="barra-pesquisa">

        <input
            type="text"
            placeholder="🔎  Pesquisar comunidades..."
        >

        <button class="botao-criar">
            ＋ Criar comunidade
        </button>

    </div>


    <!-- DESTAQUES -->

    <div class="titulo-secao">

        <h3>🔥 Comunidades em destaque</h3>

        <span>Mais populares</span>

    </div>


    <section class="cards-destaque">


        <!-- FPS -->

        <div class="card-destaque">

            <div class="icone">
                🎯
            </div>

            <h4>FPS</h4>

            <p class="descricao">
                Mira, estratégias, partidas ranqueadas
                e tudo sobre jogos de tiro.
            </p>

            <div class="card-inferior">

                <span class="membros">
                    12,4 mil membros
                </span>

                <a href="#" class="botao-entrar">
                    ENTRAR →
                </a>

            </div>

        </div>


        <!-- horror -->

        <div class="card-destaque">

            <div class="icone">
                👻
            </div>

            <h4>Terror & Horror</h4>

            <p class="descricao">
                Teorias, sustos, histórias e
                recomendações de jogos de terror.
            </p>

            <div class="card-inferior">

                <span class="membros">
                    8,2 mil membros
                </span>

                <a href="#" class="botao-entrar">
                    ENTRAR →
                </a>

            </div>

        </div>


        <!-- minecraft -->

        <div class="card-destaque">

            <div class="icone">
                ⛏️
            </div>

            <h4>Minecraft</h4>

            <p class="descricao">
                Construções, sobrevivência, mods
                e aventuras com outros players.
            </p>

            <div class="card-inferior">

                <span class="membros">
                    15,6 mil membros
                </span>

                <a href="#" class="botao-entrar">
                    ENTRAR →
                </a>

            </div>

        </div>


    </section>


    <!-- todsos -->

    <div class="titulo-secao">

        <h3>🎮 Todas as comunidades</h3>

        <span>Explorar</span>

    </div>


    <section class="todas-comunidades">


        <div class="card-comunidade">

            <div class="emoji">⚔️</div>

            <h4>Ação</h4>

            <p>2,8 mil menbros</p>

        </div>


        <div class="card-comunidade">

            <div class="emoji">🧙</div>

            <h4>RPG</h4>

            <p>6,1 mil membros</p>

        </div>


        <div class="card-comunidade">

            <div class="emoji">🏎️</div>

            <h4>Corrida</h4>

            <p>3,4 mil membros</p>

        </div>


        <div class="card-comunidade">

            <div class="emoji">🧩</div>

            <h4>Quebra-Cabeças</h4>

            <p>1,2 mil membros</p>

        </div>


        <div class="card-comunidade">

            <div class="emoji">🌎</div>

            <h4>Aventura</h4>

            <p>4,8 mil membros</p>

        </div>


        <div class="card-comunidade">

            <div class="emoji">🤝</div>

            <h4>Cooperativo</h4>

            <p>5,7 mil membros</p>

        </div>


        <div class="card-comunidade">

            <div class="emoji">🏆</div>

            <h4>Competitivo</h4>

            <p>7,9 mil membros</p>

        </div>


        <div class="card-comunidade">

            <div class="emoji">🎮</div>

            <h4>Geral</h4>

            <p>18,3 mil membros</p>

        </div>


    </section>


    <!-- DISCUSSÕES -->

    <div class="titulo-secao">

        <h3>💬 Discussões recentes</h3>

        <span>Ver todas</span>

    </div>


    <section class="discussoes">


        <div class="discussao">

            <div>

                <h4>
                    Qual jogo vocês estão jogando atualmente?
                </h4>

                <p>
                    🎮 Geral • publicado há 12 minutos
                </p>

            </div>

            <span class="comentarios">
                💬 42
            </span>

        </div>


        <div class="discussao">

            <div>

                <h4>
                    Qual personagem de FPS vocês mais gostam?
                </h4>

                <p>
                    🎯 FPS • publicado há 28 minutos
                </p>

            </div>

            <span class="comentarios">
                💬 27
            </span>

        </div>


        <div class="discussao">

            <div>

                <h4>
                    Recomendem jogos de terror!
                </h4>

                <p>
                    👻 Terror & Horror • publicado há 1 hora
                </p>

            </div>

            <span class="comentarios">
                💬 18
            </span>

        </div>


        <div class="discussao">

            <div>

                <h4>
                    Qual foi o melhor jogo que vocês jogaram esse ano?
                </h4>

                <p>
                    🎮 Geral • publicado há 2 horas
                </p>

            </div>

            <span class="comentarios">
                💬 64
            </span>

        </div>


    </section>


</main>


</body>

</html>
